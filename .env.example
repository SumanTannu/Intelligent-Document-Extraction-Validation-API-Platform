# Optional override when Tesseract is not on PATH or installed in the standard
# Windows Program Files location.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=eng

LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
LLM_MAX_COMPLETION_TOKENS=4096
FINANCIAL_VALIDATION_TOLERANCE=0.01
DATABASE_URL=sqlite:///./intellidoc.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# OCR defaults favor accuracy. Lower the DPI and disable the sparse third pass
# on memory-constrained deployments such as Render's free 512 MB instance.
OCR_MULTI_PASS=true
OCR_RENDER_DPI=350
OCR_SECONDARY_RENDER_DPI=450
OCR_SPARSE_PASS=true
